# DocGuard configuration. Copy to `.env` and fill in as needed.
# EVERYTHING RUNS WITHOUT THESE using deterministic mock providers.

# --- LLM provider ---
# One of: mock (default), openai, anthropic
DOCGUARD_LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model names (only used when provider != mock)
DOCGUARD_OPENAI_MODEL=gpt-4o-mini
DOCGUARD_ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings provider ---
# One of: mock (default), openai
DOCGUARD_EMBEDDING_PROVIDER=mock
DOCGUARD_OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Vector store ---
# One of: local (default, file-backed), chroma
DOCGUARD_VECTOR_BACKEND=local

# --- Mapping ---
DOCGUARD_SIMILARITY_THRESHOLD=0.35

# --- Confidence thresholds (0..1) ---
DOCGUARD_HIGH_CONFIDENCE=0.85
DOCGUARD_MEDIUM_CONFIDENCE=0.5

# --- GitHub integration (only for the Action / real PR mode) ---
GITHUB_TOKEN=
DOCGUARD_AUTO_FIX=false
DOCGUARD_DOCS_PATHS=docs
DOCGUARD_SRC_PATHS=src
